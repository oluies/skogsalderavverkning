# Downloaded source data and the built database — reproducible via scripts/
data/raw/
data/geo/
data/*.duckdb
data/*.duckdb.wal

# Nothing writes loose JSON to site/ any more - the browser data lives in
# site/data/ (parquet plus counties.json) and is committed. Keep ignoring the
# old location so stale output from the retired export.sql pipeline, or from an
# older checkout, cannot be committed by accident.
site/*.json

# Compiled by scala-cli in CI; not a source artefact
site/js/app.js
.scala-build/
.bsp/

# Mill writes daemon state (lock files, PIDs, absolute cache paths) into out/.
# There is no Mill build here - this appeared from running `mill --version` -
# but ignore it so a stray invocation can never dirty the tree again.
/out/

__pycache__/
*.pyc
.DS_Store

# roborev snapshots
/.roborev/

# generated by scripts/build_pages.py for GitHub Pages
/dist/
