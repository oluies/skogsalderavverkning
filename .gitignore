# Downloaded source data and the built database — reproducible via scripts/
data/raw/
data/geo/
data/*.duckdb
data/*.duckdb.wal

# Intermediate exports from export.sql. make_payload.py bundles these into
# site/payload.json, which inline_payload.py inlines into site/index.html.
site/*.json
!site/payload.json

# Compiled by scala-cli in CI; not a source artefact
site/js/app.js
.scala-build/
.bsp/

# Mill writes daemon state (lock files, PIDs, absolute cache paths) into out/.
# There is no Mill build here - this appeared from running `mill --version` -
# but ignore it so a stray invocation can never dirty the tree again.
/out/

__pycache__/
*.pyc
.DS_Store

# roborev snapshots
/.roborev/

# generated by scripts/build_pages.py for GitHub Pages
/dist/
